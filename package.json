{
  "name": "bg-remove-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "vite dev",
    "generate:code": "pnpm generate:i18n && pnpm generate:routes",
    "generate:i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy url baseLocale --silent",
    "generate:routes": "tsr generate",
    "generate-sitemap": "tsx scripts/generate-sitemap.ts",
    "build": "pnpm generate:code && pnpm generate-sitemap && vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch:lint": "steiger ./src",
    "quality:fallow": "fallow audit --base main --gate new-only --format json --quiet",
    "quality:fallow:health": "fallow health --hotspots --targets --format json --quiet",
    "quality:fallow:review": "fallow review --base main --format json --quiet",
    "security:licenses": "node scripts/check-production-licenses.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "tsx scripts/run-e2e.ts",
    "e2e:ci-critical": "tsx scripts/run-e2e.ts e2e/ci-critical.spec.ts --project=chromium --workers=1",
    "e2e:real-model": "E2E_PHASE43_REAL=1 tsx scripts/run-e2e.ts e2e/phase-43-public-cutover.real.spec.ts --project=chromium --workers=1",
    "e2e:model-lab-real": "VITE_ENABLE_MODEL_LAB=true E2E_MODEL_LAB_REAL=1 tsx scripts/run-e2e.ts e2e/model-lab.real.spec.ts --project=chromium --workers=1",
    "e2e:matting-lab-real": "VITE_ENABLE_MODEL_LAB=true E2E_MATTING_LAB_REAL=1 tsx scripts/run-e2e.ts e2e/matting-lab.real.spec.ts --project=chromium --workers=1",
    "e2e:phase-33-real": "E2E_PHASE33_REAL=1 tsx scripts/run-e2e.ts e2e/phase-33-editor-v2.real.spec.ts --project=chromium --workers=1",
    "e2e:phase-34-real": "E2E_PHASE34_REAL=1 tsx scripts/run-e2e.ts e2e/phase-34-manual-cutout.real.spec.ts --project=chromium --workers=1",
    "e2e:phase-35-real": "E2E_PHASE35_REAL=1 tsx scripts/run-e2e.ts e2e/phase-35-magic-cutout.real.spec.ts --project=chromium --workers=1",
    "e2e:phase-36-real": "E2E_PHASE36_REAL=1 tsx scripts/run-e2e.ts e2e/phase-36-finishing-tools.real.spec.ts --project=chromium --workers=1",
    "e2e:phase-37-real": "E2E_PHASE37_REAL=1 tsx scripts/run-e2e.ts e2e/phase-37-batch-workspace.real.spec.ts --project=chromium --workers=1",
    "e2e:phase-38-real": "E2E_PHASE38_REAL=1 tsx scripts/run-e2e.ts e2e/phase-38-cutover-readiness.real.spec.ts --project=chromium --workers=1",
    "e2e:phase-43-real": "E2E_PHASE43_REAL=1 tsx scripts/run-e2e.ts e2e/phase-43-public-cutover.real.spec.ts --project=chromium --workers=1",
    "e2e:full": "pnpm e2e && pnpm e2e:real-model",
    "release:test": "vitest run tests/release-operations.test.ts tests/operations.test.ts",
    "release:test:docker": "./scripts/release/disposable-test.sh",
    "sync-model-assets": "node scripts/sync-model-assets.ts",
    "profile:phase-33": "node scripts/profiling/v2/run-phase-33.mjs",
    "profile:phase-34": "node scripts/profiling/v2/run-phase-34.mjs",
    "profile:phase-35": "node scripts/profiling/v2/run-phase-35.mjs",
    "profile:phase-36": "node scripts/profiling/v2/run-phase-36.mjs",
    "profile:phase-37": "node scripts/profiling/v2/run-phase-37.mjs",
    "profile:phase-38": "node scripts/profiling/v2/run-phase-38.mjs",
    "profile:phase-42": "node scripts/profiling/v2/run-phase-42.mjs",
    "profile:phase-43": "node scripts/profiling/v2/run-phase-43.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@inlang/paraglide-js": "^2.21.0",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-start": "^1.168.27",
    "@xstate/react": "6.1.0",
    "class-variance-authority": "^0.7.1",
    "client-zip": "^2.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "onnxruntime-web": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xstate": "5.32.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "^10.0.1",
    "@feature-sliced/steiger-plugin": "^0.6.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/router-cli": "^1.167.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fallow": "3.14.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "nitro": "3.0.260610-beta",
    "prettier": "^3.9.5",
    "shadcn": "^4.16.0",
    "steiger": "^0.5.13",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
