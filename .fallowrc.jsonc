{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": ["scripts/profiling/editor/verify-phase-43-reports.ts"],
  "ignoreDependencies": ["@welldone-software/why-did-you-render", "onnxruntime-web"],
  "health": {
    "thresholdOverrides": [
      {
        "files": ["src/widgets/editor/ui/editor-tools/enhancements-tool-panel.tsx"],
        "maxCyclomatic": 26,
        "maxCognitive": 27,
        "reason": "Accepted Phase-42 presentation moved from the deleted legacy-named widget into editor presentation ownership.",
      },
      {
        "files": ["src/widgets/editor/ui/editor-tools/editor-toolbar.tsx"],
        "maxCognitive": 28,
        "reason": "Accepted Phase-42 presentation moved from the deleted legacy-named widget into editor presentation ownership.",
      },
      {
        "files": ["src/widgets/editor/ui/editor-tools/canvas-view-controls.tsx"],
        "maxCrap": 32,
        "reason": "Accepted Phase-42 presentation relocation is recorded without treating the file move as newly introduced complexity.",
      },
      {
        "files": ["src/widgets/editor/ui/manual-cutout/manual-cutout-canvas.tsx"],
        "maxCognitive": 21,
        "reason": "The focused Manual canvas owner intentionally keeps pointer capture, imperative brush preview, pan/zoom, and matching cleanup together; workflow and panel rendering live elsewhere.",
      },
      {
        "files": ["src/widgets/editor/ui/magic-cutout/magic-cutout-workspace.tsx"],
        "maxCognitive": 25,
        "reason": "The focused Magic canvas owner intentionally keeps requestAnimationFrame painting, pointer capture, pan/zoom, and matching cleanup together; workflow, commands, and panel rendering live elsewhere.",
      },
    ],
  },
  "rules": {
    "boundary-violation": "error",
    "private-type-leaks": "warn",
    "prop-drilling": "warn",
    "stale-suppressions": "warn",
  },
  "duplicates": {
    "mode": "mild",
    "minTokens": 50,
    "minLines": 5,
    "minOccurrences": 3,
    "threshold": 0,
  },
  "boundaries": {
    "zones": [
      {
        "name": "editor-tests",
        "patterns": [
          "src/editor/**/*.test.ts",
          "src/editor/**/*.test.tsx",
          "src/widgets/editor/**/*.test.ts",
          "src/widgets/editor/**/*.test.tsx",
        ],
      },
      { "name": "editor-domain", "patterns": ["src/editor/domain/**"] },
      { "name": "editor-application", "patterns": ["src/editor/application/**"] },
      { "name": "editor-runtime", "patterns": ["src/editor/runtime/**"] },
      { "name": "editor-testing", "patterns": ["src/editor/testing/**"] },
      { "name": "editor-widget", "patterns": ["src/widgets/editor/**"] },
    ],
    "rules": [
      {
        "from": "editor-tests",
        "allow": [
          "editor-tests",
          "editor-domain",
          "editor-application",
          "editor-runtime",
          "editor-testing",
          "editor-widget",
        ],
      },
      { "from": "editor-domain", "allow": ["editor-domain"] },
      {
        "from": "editor-application",
        "allow": ["editor-application", "editor-domain"],
      },
      {
        "from": "editor-runtime",
        "allow": ["editor-runtime", "editor-application", "editor-domain"],
      },
      {
        "from": "editor-testing",
        "allow": [
          "editor-testing",
          "editor-application",
          "editor-runtime",
          "editor-domain",
        ],
      },
      {
        "from": "editor-widget",
        "allow": [
          "editor-widget",
          "editor-application",
          "editor-runtime",
          "editor-domain",
        ],
      },
    ],
  },
}
